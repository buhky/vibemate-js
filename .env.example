# Copy this file to .env and fill it in. Never commit .env.

# Required: bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: comma-separated guild IDs for instant command registration
# (leave empty to register globally; global updates can take up to an hour)
#GUILD_IDS=

# Optional: image shown next to the "VibeMate" name on the now-playing panel.
# Note that any URL here is visible to everyone who sees the panel.
#BOT_LOGO_URL=

# Optional: Netscape cookies file for yt-dlp (age-restricted / bot-check videos)
#YTDLP_COOKIES=/app/data/cookies.txt

# Optional: extra yt-dlp arguments, space separated
#YTDLP_EXTRA_ARGS=

# Optional overrides (defaults shown are what the Docker image uses)
#YTDLP_PATH=/opt/ytdlp/bin/yt-dlp
#FFMPEG_PATH=ffmpeg
#DATA_DIR=/app/data
#TMP_DIR=/app/.vibemate_tmp
